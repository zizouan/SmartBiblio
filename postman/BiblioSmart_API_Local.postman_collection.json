            "body": {
              "mode": "raw",
              "raw": "{\n  \"isbn\": \"9781234567{{run_short}}\",\n  \"title\": \"Les Miserables {{run_id}}\",\n  \"language\": \"fr\",\n  \"total_copies\": 1,\n  \"available_copies\": 1,\n  \"author_ids\": [\"{{author_id}}\"],\n  \"genre_ids\": [\"{{genre_id}}\"]\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/books",
              "host": ["{{baseUrl}}"],
