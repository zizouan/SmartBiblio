    },
    {
      "name": "3 - Loans",
      "item": [
        {
          "name": "POST Create Loan (Assisted)",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Status is 201', function () { pm.response.to.have.status(201); });",
                  "const json = pm.response.json();",
                  "pm.collectionVariables.set('loan_id', json.data.id);"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" },
              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": \"{{member_id}}\",\n  \"book_copy_id\": \"{{book_copy_id}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans"]
            }
          }
        },
        {
          "name": "POST Return Loan",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/loans/{{loan_id}}/return",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "loans", "{{loan_id}}", "return"]
            }
          }
        }
      ]
    },
    {
      "name": "4 - Search & Lists",
      "item": [
        {
          "name": "GET Search Books",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{access_token}}" }
            ],
            "url": {
              "raw": "{{baseUrl}}/api/v1/search/books?title=Les&language=fr&available_only=1",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "search", "books"],
              "query": [
                { "key": "title", "value": "Les" },
                { "key": "language", "value": "fr" },
                { "key": "available_only", "value": "1" }
              ]
            }
          }
        },
        {
          "name": "GET Members",
          "request": {
            "method": "GET",
