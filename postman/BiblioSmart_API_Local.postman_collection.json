              { "key": "Content-Type", "value": "application/json" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{member_email}}\",\n  \"password\": \"{{member_password}}\",\n  \"first_name\": \"Reader\",\n  \"last_name\": \"One\",\n  \"role\": \"reader\",\n  \"is_active\": true\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/api/v1/members",
              "host": ["{{baseUrl}}"],
              "path": ["api", "v1", "members"]
            }
          }
        },
